# =============================================================================
# Fieldstone — Environment Configuration
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=fieldstone
POSTGRES_PASSWORD=changeme_required
POSTGRES_DB=fieldstone

# ─── Per-Service Database DSNs ───────────────────────────────────────────────
# Services connect through PgBouncer (transaction pool mode). Each service uses
# a distinct PgBouncer "database" name that maps to the real database with the
# correct search_path override — no search_path in the DSN is needed.
IDENTITY_DATABASE_DSN=postgres://fieldstone:changeme_required@pgbouncer:5432/identity?sslmode=disable
PERMITS_DATABASE_DSN=postgres://fieldstone:changeme_required@pgbouncer:5432/permits?sslmode=disable
REQUESTS_DATABASE_DSN=postgres://fieldstone:changeme_required@pgbouncer:5432/requests?sslmode=disable
RECORDS_DATABASE_DSN=postgres://fieldstone:changeme_required@pgbouncer:5432/records?sslmode=disable
AUDIT_DATABASE_DSN=postgres://fieldstone:changeme_required@pgbouncer:5432/audit?sslmode=disable
WEBHOOKS_DATABASE_DSN=postgres://fieldstone:changeme_required@pgbouncer:5432/webhooks?sslmode=disable

# ─── NATS ────────────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ─── OIDC (Azure AD / Entra example) ─────────────────────────────────────────
# Replace <tenant-id> and <your-app-id> with your Azure AD values.
# Other OIDC providers (Keycloak, Auth0, Okta) work the same way.
OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_AUDIENCE=api://<your-app-id>

# ─── Gateway ─────────────────────────────────────────────────────────────────
GATEWAY_PORT=:8080
ALLOWED_ORIGINS=https://your-city.gov

# ─── Internal Service URLs (Docker network names) ────────────────────────────
PERMITS_SERVICE_URL=http://permits:8081
REQUESTS_SERVICE_URL=http://requests:8082
RECORDS_SERVICE_URL=http://records:8083
IDENTITY_SERVICE_URL=http://identity:8084
WORKFLOW_SERVICE_URL=http://workflow:8085
WEBHOOKS_SERVICE_URL=http://webhooks:8086
AUDIT_SERVICE_URL=http://audit:8087

# ─── Service Listen Addresses ────────────────────────────────────────────────
IDENTITY_ADDR=:8084
PERMITS_ADDR=:8081
REQUESTS_ADDR=:8082
RECORDS_ADDR=:8083
WORKFLOW_ADDR=:8085
WEBHOOKS_ADDR=:8086
AUDIT_ADDR=:8087
NOTIFY_ADDR=:8088
WORKFLOWS_DIR=/etc/fieldstone/workflows

# ─── Logging ─────────────────────────────────────────────────────────────────
# Options: debug | info | warn | error
LOG_LEVEL=info
ENVIRONMENT=production
